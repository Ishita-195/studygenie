#!/usr/bin/env python3

import os
import json
import sqlite3
import logging
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Union

import fitz
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

from flask import Flask, request, jsonify, Response, stream_with_context
from flask_cors import CORS
from groq import Groq

# ================= CONFIG =================
UPLOAD_FOLDER = Path(__file__).parent.parent / "uploads"
DB_PATH = Path(__file__).parent.parent / "knowledge_base.db"

UPLOAD_FOLDER.mkdir(exist_ok=True)

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = Flask(__name__)
CORS(app)

groq_client = Groq(api_key=os.getenv("GROQ_API_KEY"))

# ================= PDF =================
def extract_text(pdf_path):
    doc = fitz.open(pdf_path)
    text = ""
    for page in doc:
        text += page.get_text()
    doc.close()
    return text

def chunk_text(text, size=500):
    chunks = []
    overlap = 100

    for i in range(0, len(text), size - overlap):
        chunk = text[i:i+size]
        if len(chunk.strip()) > 50:
            chunks.append(chunk)

    return chunks

def build_vectorizer(chunks):
    vec = TfidfVectorizer(stop_words='english')
    vec.fit(chunks)
    return vec

# ================= RETRIEVAL =================
def retrieve(query, chunks, vectorizer):
    q_vec = vectorizer.transform([query])
    c_vec = vectorizer.transform(chunks)

    sims = cosine_similarity(q_vec, c_vec)[0]

    idx = np.argsort(sims)[-5:][::-1]

    results = [chunks[i] for i in idx if sims[i] > 0.1]

    return results if results else chunks[:3]

# ================= QA =================
def ask_question(query, context_chunks, stream=False):
    context = "\n\n".join(context_chunks)

    system_prompt = """You are an intelligent assistant helping students.

Use the provided context to answer the question.

If the answer is partially present, try to infer logically.

Do NOT say "not enough information" unless absolutely nothing is relevant."""

    user_message = f"""
Context:
{context}

Question: {query}
"""

    try:
        if stream:
            def generate():
                with groq_client.messages.stream(
                    model="llama-3.1-70b-versatile",
                    messages=[{"role": "user", "content": user_message}],
                ) as groq_stream:
                    for text in groq_stream.text_stream:
                        yield text

            return Response(stream_with_context(generate()),
                            mimetype="text/event-stream")

        else:
            res = groq_client.messages.create(
                model="llama-3.1-70b-versatile",
                messages=[{"role": "user", "content": user_message}],
            )
            return {"answer": res.content[0].text}

    except Exception as e:
        return {"error": str(e)}

# ================= ROUTES =================
@app.route("/status")
def status():
    return {"status": "ok"}

@app.route("/upload-and-index", methods=["POST"])
def upload():
    file = request.files["file"]
    user_id = request.form.get("user_id", "user")

    path = UPLOAD_FOLDER / file.filename
    file.save(path)

    text = extract_text(str(path))
    chunks = chunk_text(text)
    vec = build_vectorizer(chunks)

    import pickle
    with open(UPLOAD_FOLDER / "data.pkl", "wb") as f:
        pickle.dump((vec, chunks), f)

    return {"status": "uploaded"}

@app.route("/ask", methods=["POST"])
def ask():
    data = request.json
    query = data["question"]

    import pickle
    with open(UPLOAD_FOLDER / "data.pkl", "rb") as f:
        vec, chunks = pickle.load(f)

    rel = retrieve(query, chunks, vec)
    ans = ask_question(query, rel)

    return jsonify(ans)

# ================= MAIN =================
if __name__ == "__main__":
    app.run(debug=True)