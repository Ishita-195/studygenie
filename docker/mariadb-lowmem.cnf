# Trim MariaDB memory so it coexists with Flask + Apache in ~512 MB.
[mysqld]
skip-name-resolve
innodb_buffer_pool_size = 32M
innodb_log_buffer_size  = 4M
performance_schema      = OFF
key_buffer_size         = 8M
tmp_table_size          = 8M
max_heap_table_size     = 8M
max_connections         = 20
table_open_cache        = 64
